<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="32dp"
        android:paddingHorizontal="8dp"
        android:textColor="@color/keyboard_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/switch_keyboard"
            style="@style/Key"
            android:contentDescription="@string/switch_keyboard"
            android:text="⌨" />

        <TextView
            android:id="@+id/mic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/mic_background"
            android:contentDescription="@string/mic_description"
            android:gravity="center"
            android:textColor="@color/mic_text"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/backspace"
                style="@style/Key"
                android:layout_height="0dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/backspace"
                android:text="⌫" />

            <TextView
                android:id="@+id/enter"
                style="@style/Key"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/enter"
                android:text="⏎" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
